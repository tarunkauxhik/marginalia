# One model credential is required for live answers.
# Keys stay on the server. Do not prefix them with NEXT_PUBLIC_.
# The browser has no credential field.

# OpenAI-compatible chat completions (POST {base}/chat/completions, Bearer auth).
# This route is used when REPO_ASSISTANT_API_KEY is set.
# Defaults, both public:
#   base URL https://llm-gateway-azure.penpencil.guru/v1
#   model    MiniMax-M3.1-Flash
REPO_ASSISTANT_API_KEY=
# REPO_ASSISTANT_BASE_URL=https://llm-gateway-azure.penpencil.guru/v1
# REPO_ASSISTANT_MODEL=MiniMax-M3.1-Flash

# Other providers, used only when REPO_ASSISTANT_API_KEY is unset.
# AI_GATEWAY_API_KEY=
# AI_MODEL=openai/gpt-5.4-mini
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Optional. Raises GitHub rate limits. Sent only to api.github.com.
# Use a public-read token. Write and administration scopes are unnecessary.
# GITHUB_TOKEN=
